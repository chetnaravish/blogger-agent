{
  "name": "blogger-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Publishes exactly one AI-written blog post per day to a Blogger blog via Groq + Pixabay images + Blogger API.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "auth": "node scripts/auth.js",
    "check": "node scripts/check-env.js",
    "post": "node src/index.js",
    "daily": "node src/index.js",
    "portfolio:scheduled": "node src/portfolioEntry.js --scheduled",
    "portfolio:dry": "node src/portfolioEntry.js --dry",
    "portfolio:publish": "node src/portfolioEntry.js --publish"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  }
}