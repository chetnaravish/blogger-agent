# ============================================================
#  Blogger Agent - environment variables
#  Fill in the VALUES after the "=" sign. Keep the quotes "".
#  This file is SAFE to commit (it has no real keys).
#  Your private .env file is already in .gitignore.
# ============================================================

# --- Google / Blogger (Blogger API v3) ---
# From: Google Cloud Console > APIs & Services > Credentials > OAuth client (Desktop app)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# From: npm run auth  (printed once in the terminal, paste it here)
GOOGLE_REFRESH_TOKEN=""

# From: npm run auth  (it prints the blog id for your blog)
BLOGGER_BLOG_ID=""

# --- Groq (writes the topic + article) ---
# From: https://console.groq.com/keys
GROQ_API_KEY=""

# Optional. Default: qwen/qwen3.8-27b
# Do NOT use the gpt-oss models: they are reasoning models, they burn the
# token limit on thinking and return empty / invalid JSON.
# If a model is retired, the agent auto-picks a current one.
GROQ_MODEL=""

# --- Images ---
# NO image API key is needed. Images come from Pollinations (free)
# and fall back to Openverse (free). Nothing to put here.

# --- Optional settings ---
# Default: AI tools, web development, and digital marketing for beginners
BLOG_NICHE=""

# Default: English
BLOG_LANGUAGE=""

# Default: true  (true = save as DRAFT, false = publish LIVE)
# Only set this to false when you are ready to go live!
PUBLISH_AS_DRAFT=""

# Only used when PUBLISH_AS_DRAFT is "auto" (that is how GitHub Actions
# calls it). Set this to true to let the daily 8 AM run publish live.
PUBLISH_LIVE_DAILY=""

# --- Images and GitHub ---
# Images are saved into the images/ folder and served through jsDelivr,
# so they only show up after that folder is pushed to GitHub.
# Set this to true in GitHub Actions so the agent commits and pushes
# images on its own. Leave blank locally and you push them yourself.
AUTO_COMMIT_PUSH=""

# Optional. Default: 60 (seconds to wait for one image)
IMAGE_TIMEOUT_SEC=""