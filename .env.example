# ============================================================
#  Blogger Agent - environment variables
#  Fill in the VALUES after the "=" sign. Keep the quotes "".
#  This file is SAFE to commit (it has no real keys).
#  Your private .env file is already in .gitignore.
# ============================================================

# --- Google / Blogger (Blogger API v3) ---
# From: Google Cloud Console > APIs & Services > Credentials > OAuth client (Desktop app)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# From: npm run auth  (printed once in the terminal, paste it here)
GOOGLE_REFRESH_TOKEN=""

# From: npm run auth  (it prints the blog id for your blog)
BLOGGER_BLOG_ID=""

# --- Groq (writes the topic + article) ---
# From: https://console.groq.com/keys
GROQ_API_KEY=""

# Optional. Default: qwen/qwen3.8-27b
# Do NOT use the gpt-oss models: they are reasoning models, they burn the
# token limit on thinking and return empty / invalid JSON.
# If a model is retired, the agent auto-picks a current one.
GROQ_MODEL=""

# Optional. Use a different Groq model for the portfolio article only.
# The Blogger step keeps using GROQ_MODEL. Blank = same as GROQ_MODEL.
PORTFOLIO_GROQ_MODEL=""

# --- Images (Pixabay) ---
# REQUIRED. Sign up free at https://pixabay.com/api/docs/ and copy your key.
# Pictures are searched using the topic words, resized to <=1280px wide and
# <=300KB, saved into images/ and served from jsDelivr.
PIXABAY_API_KEY=""

# --- Optional settings ---
# Default: AI tools, web development, and digital marketing for beginners
BLOG_NICHE=""

# Default: English
BLOG_LANGUAGE=""

# Default: true  (true = save as DRAFT, false = publish LIVE)
# Only set this to false when you are ready to go live!
PUBLISH_AS_DRAFT=""

# Only used when PUBLISH_AS_DRAFT is "auto" (that is how GitHub Actions
# calls it). Set this to true to let the daily 8 AM run publish live.
PUBLISH_LIVE_DAILY=""

# --- Images and GitHub ---
# Images are saved into the images/ folder and served through jsDelivr,
# so they only show up after that folder is pushed to GitHub.
# Set this to true in GitHub Actions so the agent commits and pushes
# images on its own. Leave blank locally and you push them yourself.
AUTO_COMMIT_PUSH=""

# Optional. Default: 60 (seconds to wait for one image)
IMAGE_TIMEOUT_SEC=""

# Optional. Default: https://chetnaportflio.vercel.app/
# Your portfolio link. It is added to the blog post on ALTERNATE days
# (odd day of the month = link included, even day = skipped).
PORTFOLIO_URL=""

# --- Portfolio website (the separate static site repository) ---
# Fine-grained GitHub token with Contents: Read and write on
# chetnaravish/portfolio. Treat it like a password.
PORTFOLIO_GH_TOKEN=""

# Default: chetnaravish/portfolio
PORTFOLIO_REPO="chetnaravish/portfolio"

# Default: main
PORTFOLIO_BRANCH="main"

# Default: https://chetnaportflio.vercel.app
PORTFOLIO_SITE_URL="https://chetnaportflio.vercel.app"

# The scheduled portfolio run (npm run portfolio:scheduled, and the
# "portfolio" job in GitHub Actions) pushes ONLY when this is exactly "true".
# Anything else (including blank) is a dry run into out/portfolio/.
PORTFOLIO_PUBLISH="false"

# Optional. Set to "true" only if you really want a second portfolio
# post on the same IST date. A duplicate topic is always skipped.
PORTFOLIO_FORCE=""

# Default: 3. Portfolio gets a new post only when at least this many
# calendar days (IST) have passed since the newest date in
# automation/published-posts.json. PORTFOLIO_FORCE=true bypasses it.
PORTFOLIO_INTERVAL_DAYS="3"